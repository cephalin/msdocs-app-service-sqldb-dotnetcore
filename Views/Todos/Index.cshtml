@model TodosIndexViewModel

@{
    ViewData["Title"] = "Todos";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-header">New Todo</div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="NewTodo.Description"></label>
                        <input asp-for="NewTodo.Description" class="form-control" />
                        <span asp-validation-for="NewTodo.Description" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Add Todo</button>
                </form>
            </div>
        </div>

        @if (Model.Todos.Count > 0)
        {
            <div class="card">
                <div class="card-header">Current Todos</div>
                <div class="card-body">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var todo in Model.Todos)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(_ => todo.Description)</td>
                                    <td class="text-end">
                                        <form asp-action="Delete" asp-route-id="@todo.ID" method="post">
                                            <button type="submit" class="btn btn-danger">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
